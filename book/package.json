{
  "name": "ahoi-book",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build:wasm": "wasm-pack build examples/rust --target web --out-dir pkg",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:react": "tsc --noEmit -p examples/tsconfig.react.json",
    "check:vue": "vue-tsc --noEmit -p examples/tsconfig.vue.json",
    "check:svelte": "svelte-check --tsconfig examples/tsconfig.svelte.json",
    "check:examples": "pnpm check && pnpm check:react && pnpm check:vue && pnpm check:svelte"
  },
  "dependencies": {
    "@acheul/ahoi-js": "workspace:*",
    "@astrojs/solid-js": "^7.0.1",
    "@astrojs/starlight": "^0.41.6",
    "@fontsource-variable/comfortaa": "^5.3.0",
    "astro": "^7.1.6",
    "sharp": "^0.35.3",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "^5.9.3",
    "vue": "^3.5.40",
    "vue-tsc": "^2.2.12"
  }
}
