{
  "name": "@acheul/ahoi-js",
  "version": "0.1.1",
  "description": "JS bridge for ahoi — reactive state management from Rust to JS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/acheul/ahoi"
  },
  "keywords": ["wasm", "rust", "reactive", "solid", "react", "vue", "svelte", "state"],
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "src"],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "import": "./dist/solid.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.tests.json",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": ">=18",
    "solid-js": ">=1.8",
    "svelte": ">=4",
    "vue": ">=3.4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "solid-js": "^1.9.0",
    "svelte": "^5.0.0",
    "typescript": "^5.6.0",
    "vue": "^3.5.0"
  }
}
