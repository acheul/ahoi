{
  "name": "ahoi-js",
  "version": "0.1.0",
  "description": "JS bridge for ahoi — reactive state management from Rust to JS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/acheul/ahoi"
  },
  "keywords": ["wasm", "rust", "reactive", "solid", "state"],
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "src"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "import": "./dist/solid.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.tests.json"
  },
  "peerDependencies": {
    "solid-js": ">=1.8"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "solid-js": "^1.9.0",
    "typescript": "^5.6.0"
  }
}
